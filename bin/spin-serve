#!/usr/bin/env ruby
# frozen_string_literal: true
#
# spin-serve — the HTTP adapter. turns a spin handler (native binary or wasm)
# into a real URL.
#
# the envelope IS http, so this adapter barely transforms anything: it maps
# the incoming HTTP request to a request bag, hands it to Spin::Envelope
# (which writes an http request to the handler's stdin and reads an http
# response back), and renders the response bag as the HTTP response.
#
# usage:
#   spin-serve ./handler                 # native binary
#   spin-serve --wasm ./handler.wasm     # wasm via wasmtime
#   PORT=8080 spin-serve ./handler

require 'webrick'
require_relative '../lib/spin/envelope'

WASM    = !!ARGV.delete('--wasm')
HANDLER = ARGV.shift or abort 'usage: spin-serve [--wasm] <handler|handler.wasm>'
PORT    = (ENV['PORT'] || 4242).to_i
abort "handler not found: #{HANDLER}" unless File.exist?(HANDLER)

# HTTP request → request bag. headers become verbatim keys (already what the
# envelope wants); the verb collapses GET→read, POST/PUT/PATCH/DELETE→write.
def bag_for(req)
  bag = {
    'verb'  => Spin::Envelope.collapse_verb(req.request_method),
    'path'  => req.path,
    'query' => (req.query_string || ''),
    'body'  => (req.body || '')
  }
  req.each { |name, val| bag[name.downcase] = val } # headers as keys
  bag
end

server = WEBrick::HTTPServer.new(
  Port: PORT,
  Logger: WEBrick::Log.new($stderr, WEBrick::Log::WARN),
  AccessLog: []
)

server.mount_proc '/' do |req, res|
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  out = Spin::Envelope.call(HANDLER, bag_for(req), wasm: WASM)
  dt  = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0) * 1000).round(2)

  res.status = out['status'].to_i
  # every response-bag key beyond status/body becomes an HTTP header
  out.each do |k, v|
    next if %w[status body].include?(k)
    res[k] = v
  end
  res['X-Spin-Ms'] = dt.to_s
  res.body = out['body']
  warn "#{req.request_method} #{req.path} → #{out['status']} (#{dt}ms)"
end

trap('INT')  { server.shutdown }
trap('TERM') { server.shutdown }

warn "spin: serving #{WASM ? 'wasm' : 'native'} #{HANDLER} on http://localhost:#{PORT}"
server.start
